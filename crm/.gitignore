!src/data/*.demo.json

# Backups — contains copies of sensitive data
backups/

# OS
.DS_Store
Thumbs.db

# Editor
*.local
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*